{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boreas",
  "mainBinaryName": "Boreas",
  "version": "0.3.0",
  "identifier": "io.github.kurone-hinamori.boreas",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Boreas",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "shortDescription": "小説の表紙や挿絵を作るアプリ",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Japanese"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwOUI3QzkxMUM2RjExQzAKUldUQUVXOGNrWHliZ0RwbXhZWkRhcEdXaHRTaW1qVDF3Tnk0bk5YbVZUOEpxTlhxRHJTSlFMR2QK",
      "endpoints": [
        "https://github.com/kurone-hinamori/Boreas/releases/latest/download/latest.json"
      ]
    }
  }
}
